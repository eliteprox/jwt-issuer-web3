{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "JWT Issuer",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}",
            "console": "integratedTerminal",
            "args": [
                "-listen", ":8082",
                "-jwkPrivateKeyPath", "${workspaceFolder}/private.pem",
                "-jwkKeyID", "livepeer-key-1",
                "-siweDomain", "localhost",
                "-tokenTTL", "24h",
                // "-allowedOrigins", "https://livepeer.ai"
            ],
        },
    ]
}
